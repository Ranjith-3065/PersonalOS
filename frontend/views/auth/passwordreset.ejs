<div class="auth-form">

  <div class="field">
    <label>New Password</label>
    <input name="password" type="password" placeholder="••••••••">
    <small class="error" data-error="password"></small>
  </div>

  <button class="btn-primary" id="resetBtn">Update Password</button>

  <div class="footer-text">
    Remembered your password? <a href="/personalOS/login">Back to Login</a>
  </div>

</div>
<script>
const resetBtn = document.getElementById("resetBtn");

resetBtn.addEventListener("click", async () => {

  // Clear old errors
  document.querySelectorAll(".error").forEach(el => el.textContent = "");
  document.querySelectorAll("input").forEach(i => i.classList.remove("input-error"));

  const password = document.querySelector('input[name="password"]').value;
  const token = window.location.pathname.split("/").pop();

  const res = await fetch(`/personalOS/passwordreset/${token}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ password })
  });

  const data = await res.json();

  if (data.success) {
    window.location.href = "/personalOS/login";
    return;
  }

  // Zod field-level errors
  if (data.errors && data.errors.length) {
    data.errors.forEach(err => {
      const input = document.querySelector(`[name="${err.field}"]`);
      const errorEl = document.querySelector(`[data-error="${err.field}"]`);

      if (input) input.classList.add("input-error");
      if (errorEl) errorEl.textContent = err.message;
    });
  } else {
    alert(data.message);
  }
});
</script>
