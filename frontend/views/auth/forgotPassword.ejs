<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot Password | PersonalOS</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --bg-main: #020617;
    --bg-card: #0b1220;
    --border-soft: rgba(255,255,255,0.08);
    --text-main: #e5e7eb;
    --text-muted: #94a3b8;
    --primary: #3b82f6;
    --primary-hover: #2563eb;
    --radius-lg: 20px;
    --radius-md: 14px;
  }

  * {
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top, #1e293b, transparent 60%),
      linear-gradient(145deg, #020617, #020617);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-main);
  }

  .card {
    width: 100%;
    max-width: 420px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.2)),
      var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 36px 34px;
    border: 1px solid var(--border-soft);
    box-shadow:
      0 30px 80px rgba(0,0,0,0.75),
      inset 0 1px 0 rgba(255,255,255,0.04);
    animation: fadeUp 0.6s ease;
    position: relative;
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      120deg,
      transparent,
      rgba(255,255,255,0.05),
      transparent
    );
    opacity: 0.6;
  }

  .card h2 {
    margin: 0 0 10px;
    font-size: 26px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 0.3px;
  }

  .subtitle {
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 8px;
    color: #cbd5f5;
  }

  input {
    width: 100%;
    padding: 14px 15px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    background: #020617;
    color: var(--text-main);
    font-size: 15px;
    outline: none;
    transition: border 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  input::placeholder {
    color: #64748b;
  }

  input:focus {
    border-color: var(--primary);
    background: #020617;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
  }

  .btn {
    width: 100%;
    margin-top: 24px;
    padding: 14px;
    border: none;
    border-radius: 16px;
    background:
      linear-gradient(135deg, var(--primary), var(--primary-hover));
    color: white;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      filter 0.15s ease;
    box-shadow:
      0 14px 35px rgba(59,130,246,0.45);
  }

  .btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
    box-shadow:
      0 18px 45px rgba(59,130,246,0.6);
  }

  .btn:active {
    transform: scale(0.97);
  }

  .footer {
    margin-top: 24px;
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer a {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 500;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  /* Animation */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

</style>
</head>

<body>

  <div class="card">
    <h2>Forgot Password</h2>
    <p class="subtitle">
      Enter your email and we’ll send you a reset link
    </p>

      <label for="email">Email address</label>
      <input type="email" id="email" placeholder="you@example.com" required>
      <button class="btn">reset</button>

    <div class="footer">
      Remembered your password?
      <a href="/personalOS/login">Back to Login</a>
    </div>
  </div>

</body>

<script>
    ( () => {
        document.querySelector('.btn').addEventListener('click',async()=>{
          const email = document.querySelector('#email').value;
            const res = await fetch('/personalOS/resetpass',{
            method:'POST',
            headers:{
                'content-type':'application/json'
            },
            body:JSON.stringify({email})
        })
        const data = await res.json();
        if(data.success){
          alert("the verification link is send to your eamil go through it and change the password");
        }
        })
        
    }
)();
</script>
</html>
