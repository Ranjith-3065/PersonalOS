<div class="auth-form">

  <div class="field">
    <label>Email</label>
    <input name="email" type="email" placeholder="you@personalos.dev">
    <small class="error" data-error="email"></small>
  </div>

  <button class="btn-primary" id="forgotBtn">Send Reset Link</button>

  <div class="footer-text">
    Remembered your password? <a href="/personalOS/login">Back to Login</a>
  </div>

</div>
<script>
const forgotBtn = document.getElementById("forgotBtn");

forgotBtn.addEventListener("click", async () => {

  // Clear old errors
  document.querySelectorAll(".error").forEach(el => el.textContent = "");
  document.querySelectorAll("input").forEach(i => i.classList.remove("input-error"));

  const email = document.querySelector('input[name="email"]').value;

  const res = await fetch("/personalOS/resetpass", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email })
  });

  const data = await res.json();

  if (data.success) {
    alert("We’ve sent a password reset link to your email.");
    return;
  }

  // Zod field errors
  if (data.errors && data.errors.length) {
    data.errors.forEach(err => {
      const input = document.querySelector(`[name="${err.field}"]`);
      const errorEl = document.querySelector(`[data-error="${err.field}"]`);

      if (input) input.classList.add("input-error");
      if (errorEl) errorEl.textContent = err.message;
    });
  } else {
    alert(data.message);
  }
});
</script>
