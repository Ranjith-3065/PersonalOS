<div class="auth-form">

  <div class="field">
    <label>Email</label>
    <input name="email" type="email" placeholder="you@personalos.dev">
    <small class="error" data-error="email"></small>
  </div>

  <div class="field">
    <label>Password</label>
    <input name="password" type="password" placeholder="••••••••">
    <small class="error" data-error="password"></small>
  </div>

  <button class="btn-primary" id="loginBtn">Login</button>

  <div class="footer-text">
    Don’t have an account? <a href="/personalOS/signup">Create one</a>
  </div>

  <div class="footer-text">
    Forgot password? <a href="/personalOS/forgotpass">Reset</a>
  </div>

</div>
<script>
const loginBtn = document.getElementById("loginBtn");

loginBtn.addEventListener("click", async () => {

  // Clear old errors
  document.querySelectorAll(".error").forEach(el => el.textContent = "");
  document.querySelectorAll("input").forEach(i => i.classList.remove("input-error"));

  const email = document.querySelector('input[name="email"]').value;
  const password = document.querySelector('input[name="password"]').value;

  const res = await fetch("/personalOS/login", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email, password })
  });

  const data = await res.json();

  if (data.success) {
    window.location.href = "/personalOS/dashboard";
    return;
  }

  // Zod field-level errors
  if (data.errors && data.errors.length) {
    data.errors.forEach(err => {
      const input = document.querySelector(`[name="${err.field}"]`);
      const errorEl = document.querySelector(`[data-error="${err.field}"]`);

      if (input) input.classList.add("input-error");
      if (errorEl) errorEl.textContent = err.message;
    });
  } else {
    alert(data.message);
  }
});
</script>
