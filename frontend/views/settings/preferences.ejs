
  <main>
    <header>
      <h1>System Preferences</h1>
      <p>Fine-tune your environment for peak performance.</p>
    </header>

    <div class="grid">
      
      <div>
        <div class="section-label">Appearance & Feel</div>
        <div class="card">
          <div class="row">
            <div class="info">
              <h4>Dark Interface</h4>
              <p>Toggle between professional light and dark themes.</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="theme-toggle">
              <span class="slider"></span>
            </label>
          </div>
          <div class="row">
            <div class="info">
              <h4>System Language</h4>
              <p>Set your primary interface language.</p>
            </div>
            <select>
              <option>English (US)</option>
              <option>English (UK)</option>
              <option>Spanish</option>
              <option>German</option>
            </select>
          </div>
        </div>
      </div>

      <div>
        <div class="section-label">Interface Layout</div>
        <div class="card">
          <div class="row">
            <div class="info">
              <h4>Dashboard Style</h4>
              <p>Choose your preferred information density.</p>
            </div>
            <select>
              <option>Bento Grid (Default)</option>
              <option>List View</option>
              <option>Minimalist</option>
            </select>
          </div>
          <div class="row">
            <div class="info">
              <h4>Default Start View</h4>
              <p>The module shown immediately after login.</p>
            </div>
            <select>
              <option>Intelligence Hub</option>
              <option>Growth Tracking</option>
              <option>Encrypted Vault</option>
            </select>
          </div>
        </div>
      </div>

      <div>
        <div class="section-label">Communication</div>
        <div class="card">
          <div class="row">
            <div class="info">
              <h4>System Notifications</h4>
              <p>Receive push alerts on your current device.</p>
            </div>
            <label class="switch">
              <input type="checkbox" checked>
              <span class="slider"></span>
            </label>
          </div>
          <div class="row">
            <div class="info">
              <h4>Email Notifications</h4>
              <p>Weekly summaries and critical system alerts.</p>
            </div>
            <label class="switch">
              <input type="checkbox">
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </div>

      <div>
        <div class="section-label">Intelligence Core</div>
        <div class="card">
          <div class="row">
            <div class="info">
              <h4>AI Suggestions</h4>
              <p>Allow the engine to suggest habits and insights.</p>
            </div>
            <label class="switch">
              <input type="checkbox" checked>
              <span class="slider"></span>
            </label>
          </div>
          <div class="row">
            <div class="info">
              <h4>Predictive Loading</h4>
              <p>Optimize resource usage based on behavior.</p>
            </div>
            <label class="switch">
              <input type="checkbox" checked>
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </div>

      <div>
        <div class="section-label">Data & Backup</div>
        <div class="card">
          <div class="row">
            <div class="info">
              <h4>Cloud Workspace Storage</h4>
              <p>6.5 GB of 10 GB utilized.</p>
              <div class="storage-bar"><div class="progress-fill"></div></div>
            </div>
          </div>
          <div class="row">
            <div class="info">
              <h4>Auto-Backup Frequency</h4>
              <p>Frequency of encrypted state snapshots.</p>
            </div>
            <select>
              <option>Hourly</option>
              <option>Daily</option>
              <option>Weekly</option>
            </select>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 16px; margin-top: 20px;">
        <button class="btn">Save All Changes</button>
        <button class="btn" style="background: transparent; color: var(--text-sub); border: 1px solid var(--border);">Restore Defaults</button>
      </div>

    </div>
  </main>
