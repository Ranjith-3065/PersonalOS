<aside class="sidebar">

  <!-- BRAND (COMMON) -->
  <div class="brand">
    <div style="width:24px;height:24px;background:var(--accent);border-radius:6px;"></div>
    PersonalOS
  </div>

  <!-- ================= DASHBOARD SIDEBAR ================= -->
  <% if (sidebar === 'dashboard') { %>

    <div class="identity-card">
  <div class="user-avatar" id="avatar">?</div>

  <div class="user-details">
    <div class="u-name" id="username">Loading...</div>
    <div class="u-role">Identity Verified</div>
  </div>
</div>


    <nav>
      <a href="/personalOS/dashboard" class="nav-item <%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="#" class="nav-item">AI Assistant</a>
      <a href="/personalOS/habitsDashboard" class="nav-item">Habits</a>
      <a href="#" class="nav-item">Notes</a>
      <a href="/personalOS/tasksdashboard" class="nav-item">Tasks</a>
      <a href="#" class="nav-item">Timeline</a>
      <a href="#" class="nav-item">Vault</a>

      <a href="/personalOS/profile" class="nav-item" style="margin-top:auto;">
        Settings
      </a>

      <a href="/personalOS/login" class="nav-item" style="color:#ef4444;">
        Logout
      </a>
    </nav>

  <% } %>

  <!-- ================= SETTINGS SIDEBAR ================= -->
  <% if (sidebar === 'settings') { %>

    <a href="/personalOS/dashboard" class="back-nav">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Dashboard
    </a>

    <nav>
      <a href="/personalOS/profile"
         class="nav-item <%= active === 'profile' ? 'active' : '' %>">
        General Settings
      </a>

      <a href="/personalOS/preferences"
         class="nav-item <%= active === 'preferences' ? 'active' : '' %>">
        Account Appearance
      </a>

      <a href="/personalOS/account"
         class="nav-item <%= active === 'account' ? 'active' : '' %>">
        Account Security
      </a>

      <a href="#" class="nav-item">
        API Engine
      </a>
    </nav>

  <% } %>
  <!-- ================= TASKS SIDEBAR ================= -->
<% if (sidebar === 'tasks') { %>

  <!-- BACK -->
  <a href="/personalOS/dashboard" class="back-nav">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    Back to Main Dashboard
  </a>

  <nav class="sidebar-nav">

    <!-- DASHBOARD -->
    <a href="/personalOS/tasksdashboard"
       class="nav-item <%= active === 'dashboard' ? 'active' : '' %>">
      📊 Task Dashboard
      <span class="nav-sub">Overview & Progress</span>
    </a>

    <!-- VIEW -->
    <div class="nav-group">
      <div class="nav-label">View</div>

      <a href="/personalOS/tasks"
         class="nav-item <%= active === 'all' ? 'active' : '' %>">
        📋 All Tasks
      </a>

      <a href="/personalOS/tasks/today"
         class="nav-item <%= active === 'today' ? 'active' : '' %>">
        📅 Today
      </a>

      <a href="/personalOS/tasks/upcoming"
         class="nav-item <%= active === 'upcoming' ? 'active' : '' %>">
        ⏳ Upcoming
      </a>

      <a href="/personalOS/tasks/completed"
         class="nav-item <%= active === 'completed' ? 'active' : '' %>">
        ✅ Completed
      </a>
    </div>

    <!-- ACTIONS -->
    <div class="nav-group">
      <div class="nav-label">Actions</div>

      <a href="/personalOS/tasks/create"
         class="nav-item primary">
        ➕ Create Task
      </a>

      <a href="/personalOS/tasks/edit"
         class="nav-item">
        ✏️ Edit Tasks
      </a>
    </div>

    <!-- PROGRESS -->
    <div class="nav-group">
      <div class="nav-label">Insights</div>

      <a href="/personalOS/tasks/progress"
         class="nav-item <%= active === 'progress' ? 'active' : '' %>">
        📈 Progress Tracker
      </a>

      <a href="/personalOS/tasks/archived"
         class="nav-item <%= active === 'archived' ? 'active' : '' %>">
        🗂 Archived
      </a>
    </div>

  </nav>

<% } %>

<!-- ================= HABITS SIDEBAR ================= -->
<% if (sidebar === 'habits') { %>

  <!-- BACK -->
  <a href="/personalOS/dashboard" class="back-nav">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    Back to Main Dashboard
  </a>

  <nav class="sidebar-nav">

    <!-- DASHBOARD -->
    <a href="/personalOS/habits/dashboard"
       class="nav-item <%= active === 'dashboard' ? 'active' : '' %>">
      🔥 Habit Dashboard
      <span class="nav-sub">Streaks & consistency</span>
    </a>

    <!-- VIEW -->
    <div class="nav-group">
      <div class="nav-label">View</div>

      <a href="/personalOS/habits"
         class="nav-item <%= active === 'all' ? 'active' : '' %>">
        📋 All Habits
      </a>

      <a href="/personalOS/habits/today"
         class="nav-item <%= active === 'today' ? 'active' : '' %>">
        📅 Today
      </a>

      <a href="/personalOS/habits/streaks"
         class="nav-item <%= active === 'streaks' ? 'active' : '' %>">
        🔥 Streaks
      </a>
    </div>

    <!-- ACTIONS -->
    <div class="nav-group">
      <div class="nav-label">Actions</div>

      <a href="/personalOS/habits/create"
         class="nav-item primary">
        ➕ Create Habit
      </a>

      <a href="/personalOS/habits/edit"
         class="nav-item">
        ✏️ Edit Habits
      </a>
    </div>

    <!-- INSIGHTS -->
    <div class="nav-group">
      <div class="nav-label">Insights</div>

      <a href="/personalOS/habits/analytics"
         class="nav-item <%= active === 'analytics' ? 'active' : '' %>">
        📈 Analytics
      </a>

    </div>

  </nav>

<% } %>


</aside>
