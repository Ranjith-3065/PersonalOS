
<body>

  <!-- HEADER -->
  <header class="dashboard-header">
    <h1>Task Dashboard</h1>
    <p>Track progress, priorities, and productivity</p>
  </header>

  <!-- STATS -->
  <section class="stats-grid">
    <div class="stat-card">
      <h4>Total Tasks</h4>
      <p id="stat-total">0</p>
    </div>

    <div class="stat-card pending">
      <h4>Pending</h4>
      <p id="stat-pending">0</p>
    </div>

    <div class="stat-card progress">
      <h4>In Progress</h4>
      <p id="stat-progress">0</p>
    </div>

    <div class="stat-card completed">
      <h4>Completed</h4>
      <p id="stat-completed">0</p>
    </div>
  </section>

  <!-- TASK LIST -->
  <section class="task-section">
    <h2>Your Tasks</h2>

    <!-- TASKS WILL BE INSERTED HERE -->
    <div id="task-list">

      <!-- SAMPLE STRUCTURE (clone this via JS) -->
      <div class="task-card">
        <div class="task-top">
          <h3 class="task-title">Task title</h3>
          <span class="status pending">pending</span>
        </div>

        <p class="task-desc">Task description goes here</p>

        <div class="meta-grid">
          <div>
            <label>Priority</label>
            <span class="priority medium">medium</span>
          </div>

          <div>
            <label>Category</label>
            <span class="task-category">personal</span>
          </div>

          <div>
            <label>Due</label>
            <span class="task-due">—</span>
          </div>

          <div>
            <label>Estimated</label>
            <span class="task-estimated">0 min</span>
          </div>

          <div>
            <label>Actual</label>
            <span class="task-actual">0 min</span>
          </div>
        </div>

        <div class="tags">
          <!-- <span>#tag</span> -->
        </div>

        <div class="subtasks">
          <h4>Subtasks</h4>
          <ul class="subtask-list">
            <!-- <li class="done">Subtask</li> -->
          </ul>
        </div>
      </div>

    </div>
  </section>
<script>
  (async () => {
    const res = await fetch('/personalOS/taskdashboardload',{
      method: 'POST'
    })
    const data =await res.json();
    if(data.success){
      console.log(data.estimatedTime)
      document.querySelector('.task-actual').textContent = data.estimatedTime;
      
    }
  })
  ();
</script>
</body>

