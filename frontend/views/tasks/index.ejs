<!-- HEADER -->
<header class="tasks-header">
  <div class="header-left">
    <h1>Tasks</h1>
    <p>Plan your day. Execute with focus.</p>

    <!-- Quick Stats -->
    <div class="task-stats">
      <span><strong id="totalCount">0</strong> Total</span>
      <span><strong id="todayCount">0</strong> Today</span>
      <span><strong id="completedCount">0</strong> Done</span>
    </div>
  </div>

  <div class="header-actions">
    <a href="/personalOS/tasks/create" class="btn-primary">
      + New Task
    </a>
  </div>
</header>

<!-- FILTER + SEARCH BAR -->
<section class="tasks-toolbar">
  <div class="tasks-filters">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="today">Today</button>
    <button class="filter-btn" data-filter="upcoming">Upcoming</button>
    <button class="filter-btn" data-filter="completed">Completed</button>
  </div>

  <!-- Search -->
  <div class="tasks-search">
    <input type="text" id="taskSearch" placeholder="Search tasks..." />
  </div>
</section>

<!-- TASKS CONTAINER -->
<section class="tasks-container" id="tasksContainer">

  <!-- Loading state -->
  <div class="tasks-loading" id="tasksLoading">
    <p>Loading tasks...</p>
  </div>

  <!-- Example Task Card (JS will generate these) -->
