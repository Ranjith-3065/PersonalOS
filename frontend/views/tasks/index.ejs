    <div class="task-meta">
      <span class="task-date">📅 Today</span>
      <span class="task-tag">Work</span>
    </div>
  </div>
  -->

</section>

<!-- EMPTY STATE -->
<section class="empty-tasks" id="emptyState" style="display:none;">
  <h2>No tasks yet</h2>
  <p>Your workspace is clear. Start by creating a task and build momentum.</p>

  <div class="empty-actions">
    <a href="/personalOS/tasks/create" class="btn-primary">
      Create Task
    </a>
    <p class="empty-hint">Tip: Break big goals into small tasks ✨</p>
  </div>
</section>
