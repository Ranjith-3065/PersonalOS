<body>

<header class="page-header">
  <h1>Upcoming Tasks</h1>
  <p>Plan ahead for what's coming</p>
</header>

<section class="upcoming-grid" id="upcomingGrid">

  <!-- Empty state -->
  <div class="empty-state" id="emptyState">
    <p>No upcoming tasks</p>
  </div>

</section>

<script>
(async () => {
  const res = await fetch('/personalOS/tasks/progress/upcoming', {
    method: 'POST'
  });

  const data = await res.json();

  if (!data.success) return;

  const grid = document.getElementById('upcomingGrid');
  const emptyState = document.getElementById('emptyState');

  if (data.taksdetails.length > 0) {
    emptyState.remove();
  }

  data.taksdetails.forEach(task => {
    const card = document.createElement('div');
    card.className = 'upcoming-card';

    card.innerHTML = `
      <div class="card-top">
        <h3 class="task-title">${task.title}</h3>
        <span class="priority ${task.priority}">${task.priority}</span>
      </div>

      <p class="task-desc">${task.description || ''}</p>

      <div class="task-meta">
        <span>Due: ${
          task.dueDate 
            ? new Date(task.dueDate).toLocaleDateString('en-IN')
            : '—'
        }</span>
        <span>Estimated: ${task.estimatedTime || 0} min</span>
        <span>Status: ${task.status}</span>
      </div>
    `;

    grid.appendChild(card);
  });

})();
</script>

</body>
