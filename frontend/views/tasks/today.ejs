<body>

<header class="page-header">
  <h1>Today's Tasks</h1>
  <p>What you need to finish today</p>
</header>

<section class="task-list">

  <!-- Empty state (JS will hide when data exists) -->
  <div class="empty-state">
    <p>No tasks for today</p>
  </div>

  <!-- TASK ITEM -->
  <!-- JS will clone this block -->
  <div class="task-item">
    <div class="task-main">
      <h3 class="task-title">Task Title</h3>
      <span class="task-status">pending</span>
    </div>

    <p class="task-desc">Task description</p>

    <div class="task-meta">
      <span class="priority">Priority: High</span>
      <span class="due">Due: 20/01/2026</span>
    </div>
  </div>

</section>

</body>
