<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || "PersonalOS" %></title>

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #020617;
      --card: #0f172a;
      --border: rgba(255,255,255,0.08);
      --text: #e5e7eb;
      --muted: #94a3b8;
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --danger: #ef4444;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #1e293b, #020617);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text);
    }

    .auth-wrapper {
      width: 100%;
      max-width: 420px;
      padding: 24px;
    }

    .auth-card {
      background: linear-gradient(180deg, #0f172a, #020617);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
      box-shadow: 0 30px 60px rgba(0,0,0,0.6);
      animation: fadeUp 0.6s ease;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .brand {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand h1 {
      font-size: 26px;
      font-weight: 700;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .brand p {
      margin-top: 6px;
      font-size: 14px;
      color: var(--muted);
    }

    .auth-content {
      margin-top: 24px;
    }

    .footer-text {
      margin-top: 22px;
      font-size: 13px;
      text-align: center;
      color: var(--muted);
    }

    .footer-text a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 500;
    }

    .footer-text a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="brand">
        <h1>PersonalOS</h1>
        <p><%= subtitle || "Secure your digital workspace" %></p>
      </div>

      <!-- Page specific content -->
      <div class="auth-content">
        <%- body %>
      </div>
    </div>
  </div>
</body>
</html>

